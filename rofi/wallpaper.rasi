@import "colors.rasi"

configuration {
    font: "Silkscreen 10";
}

/* ── WINDOW ───────────────────────────────────────────────────────────────── */
window {
    width:            900px;
    background-color: @bg0;
    border:           1px;
    border-color:     @accent;
    border-radius:    16px;
    padding:          12px;
}

/* ── LAYOUT ───────────────────────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    spacing:          0px;
    children:         [ inputbar, listview ];
}

/* ── HEADER / SEARCH BAR ──────────────────────────────────────────────────── */
inputbar {
    background-color: transparent;
    padding:          4px 8px 10px 8px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @fg0;
    vertical-align:    0.5;
    placeholder:       "Search...";
    placeholder-color: @fg2;
}

case-indicator { enabled: false; }

/* ── THUMBNAIL GRID ───────────────────────────────────────────────────────── */
listview {
    background-color: transparent;
    padding:          4px 0px 0px 0px;
    spacing:          10px;
    columns:          4;
    lines:            2;
    fixed-height:     false;
    scrollbar:        false;
    cycle:            true;
}

/* ── EACH THUMBNAIL TILE ──────────────────────────────────────────────────── */
element {
    background-color: transparent;
    border-radius:    10px;
    spacing:          4px;
    padding:          6px;
    orientation:      vertical;
    children:         [ element-icon, element-text ];
}

element-icon {
    background-color: transparent;
    size:             190px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       @fg1;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    highlight:        bold;
}

/* ── STATES ───────────────────────────────────────────────────────────────── */
element.normal.normal {
    background-color: transparent;
    text-color:       @fg1;
}

element.alternate.normal {
    background-color: transparent;
    text-color:       @fg1;
}

element.selected.normal {
    background-color: @bg3;
    text-color:       @fg0;
}
