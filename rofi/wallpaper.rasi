@import "colors.rasi"

configuration {
    font: "Silkscreen 10";
}

/* ── WINDOW ───────────────────────────────────────────────────────────────── */
window {
    width:            900px;
    background-color: @bg0;
    border:           1px;
    border-color:     @accent;
    border-radius:    16px;
    padding:          0px;
    margin:           0px;
}

/* ── LAYOUT ───────────────────────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    spacing:          0px;
    children:         [ prompt, listview ];
}

prompt {
    padding:          12px 18px;
    background-color: transparent;
    text-color:       @accent;
    vertical-align:   0.5;
}

/* ── THUMBNAIL GRID ───────────────────────────────────────────────────────── */
listview {
    background-color: transparent;
    padding:          12px 10px 12px 10px;
    spacing:          12px;
    columns:          4;
    lines:            1;
    fixed-height:     false;  /* Dynamic sizing based on content */
    scrollbar:        false;
    cycle:            true;
}

/* ── EACH THUMBNAIL TILE ──────────────────────────────────────────────────── */
element {
    background-color: transparent;
    border-radius:    10px;
    spacing:          6px;
    padding:          8px;
    orientation:      vertical;
    /* CRITICAL: element-text MUST be present for dmenu script indexing to work */
    children:         [ element-icon, element-text ];
}

element-icon {
    background-color: transparent;
    /* Calculated fit: (900px - paddings - gaps) / 4 cols ≈ 180px - 200px width */
    size:             200px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

/* ── STATES ───────────────────────────────────────────────────────────────── */
element.normal.normal {
    background-color: transparent;
    text-color:       @fg1;
}

element.alternate.normal {
    background-color: transparent;
    text-color:       @fg1;
}

element.selected.normal {
    background-color: @bg3;
    text-color:       @fg0;
}
